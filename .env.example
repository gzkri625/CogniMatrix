# iyzico — Vercel'de: Project Settings → Environment Variables
# Anahtarlar: iyzico panel → Ayarlar → Firma Ayarları (sandbox için sandbox-merchant.iyzipay.com)
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# Test: https://sandbox-api.iyzipay.com   Canlı: https://api.iyzipay.com
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# İsteğe bağlı: iyzico'nun geri döneceği site adresi (boşsa isteğin geldiği adres kullanılır)
PUBLIC_URL=
